# Copy to ~/.config/clickhouse-mcp-tunnel/<profile>.env, or let install.sh write it.
# No secrets belong here — credentials live in the login keychain.

# AWS profile and region that can reach the bastion.
AWS_PROFILE=my-staging
AWS_REGION=eu-west-1

# Bastion to tunnel through: an instance id (i-...) or a Name tag to resolve.
# A Name tag survives instance replacement; an id does not.
BASTION=my-stg-bastion

# The ClickHouse endpoint. Pin REMOTE_HOST, or point REMOTE_HOST_SSM_PARAM at an
# SSM parameter so a re-provisioned service needs no edit here. This hostname is
# also the TLS SNI the client must send.
REMOTE_HOST_SSM_PARAM=/example/clickhouse/private-hostname
# REMOTE_HOST=abcdef.region.vpce.aws.clickhouse.cloud

# 8443 is ClickHouse's HTTPS interface. 9440 is the native protocol (dbt), which
# this tool does not use.
REMOTE_PORT=8443

# Local port the tunnel binds. Give each profile its own so several can be open.
LOCAL_PORT=18443

# Optional connection default; fully-qualified names work regardless.
CLICKHOUSE_DATABASE=

# Login keychain item holding the username and password.
KEYCHAIN_SERVICE=clickhouse-mcp-stg
